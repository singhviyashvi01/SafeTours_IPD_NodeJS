PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/safetours
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_here
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_here
REFRESH_TOKEN_EXPIRY=7d
NODE_ENV=development

# External APIs. Every one is optional: if a key is missing or the API is down, the matching
# risk component is reported as unavailable/stale (never a made-up number).
OPENWEATHER_API_KEY=
NEWSDATA_API_KEY=
GEOAPIFY_API_KEY=
ORS_API_KEY=

# Background job intervals in ms (weather/news default 30 min, crowd 60 min)
WEATHER_REFRESH_MS=1800000
NEWS_REFRESH_MS=1800000
CROWD_REFRESH_MS=3600000

# Optional: override the NewsData query (boolean syntax; falls back to plain "Mumbai" if rejected)
# NEWS_QUERY=

# DEMO crime data for presentations (default off). Randomised values, tagged "demo" in the API and UI.
# Real data (npm run crime:build -- file.csv) always replaces it.
USE_DEMO_CRIME_DATA=false

# Per-IP request limit per 15 minutes (default 600)
RATE_LIMIT_MAX=600

# --- Geofence detection (defaults shown; see src/config/geofence.config.js) ---
# GEOFENCE_MAX_ACCURACY_M=50        readings less accurate than this are ignored
# GEOFENCE_ENTER_SCORE=60           score that counts as danger when entering
# GEOFENCE_EXIT_SCORE=52            must drop BELOW this to count as leaving (hysteresis)
# GEOFENCE_ENTER_READINGS=3         consecutive danger readings to ENTER ...
# GEOFENCE_ENTER_DWELL_S=60         ... or this many seconds of continuous danger (min 2 readings)
# GEOFENCE_EXIT_READINGS=3
# GEOFENCE_EXIT_DWELL_S=90
# GEOFENCE_HISTORICAL_MIN=10        events older than this are history only (never start an SOS prompt)

# --- Cancellable auto-SOS and Shadow Mode ---
# SOS_CONFIRM_SECONDS=60            time the user has to answer "Are you safe?"
# SOS_COOLDOWN_MIN=30               no new geofence prompt around a cancelled cell for this long
# SOS_COOLDOWN_RING=2
# SOS_POLL_SECONDS=5                how often persisted deadlines are checked
# SOS_ACTIVE_MAX_HOURS=12           active SOS older than this is closed automatically
# JOURNEY_ARRIVAL_RADIUS_M=100
# JOURNEY_ETA_EXTEND_MIN=15

# Optional: Expo "enhanced push security" access token (push works without it)
# EXPO_ACCESS_TOKEN=

# Twilio SMS credentials (optional for production automated SMS sending)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

