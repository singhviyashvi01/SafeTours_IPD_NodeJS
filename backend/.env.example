PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/safetours
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_here
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_here
REFRESH_TOKEN_EXPIRY=7d
NODE_ENV=development

# api keys
OWM_API_KEY=your_owm_api_key
NEWS_API_KEY=your_news_api_key
SAFETOURS_API_KEY=your_safetours_api_key
ORS_API_KEY=
GEOAPIFY_API_KEY=
NEWSDATA_API_KEY=

# Twilio SMS credentials (optional for production automated SMS sending)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

